<section class="ac-section-heading">
  <div>
    <p class="ac-eyebrow">Personal</p>
    <h1>关于我</h1>
  </div>
</section>

<%
  var personal = theme.personal || {};
  var cv = theme.cv || {};
%>

<% if (personal.avatar) { %>
  <div class="ac-personal-avatar">
    <img src="<%- url_for(personal.avatar) %>" alt="<%= theme.sidebar.title || config.title %>">
  </div>
<% } %>

<% if (personal.about) { %>
  <section class="ac-hero-card" style="margin-bottom: 2rem;">
    <p class="ac-eyebrow">About Me</p>
    <p class="ac-hero-copy"><%= personal.about %></p>
  </section>
<% } %>

<% if (page.content && page.content.trim()) { %>
  <div class="ac-prose" style="margin-bottom: 2rem;">
    <%- page.content %>
  </div>
<% } %>

<% if (cv.intro || (cv.experience && cv.experience.length) || (cv.education && cv.education.length) || (cv.certifications && cv.certifications.length)) { %>
  <section class="ac-cv-section ac-personal-resume">
    <h2 class="ac-cv-section-title">履历速览</h2>
    <% if (cv.notice) { %>
      <p class="ac-resume-notice"><%= cv.notice %></p>
    <% } %>
    <% if (cv.intro) { %>
      <p class="ac-resume-intro"><%= cv.intro %></p>
    <% } %>

    <% if (cv.experience && cv.experience.length) { %>
      <h3 class="ac-resume-subtitle">经历</h3>
      <div class="ac-timeline">
        <% cv.experience.forEach(function(item){ %>
          <div class="ac-timeline-item">
            <time><%= item.period %></time>
            <div>
              <strong><%= item.title %></strong>
              <p><%= item.company %><% if (item.location) { %> · <%= item.location %><% } %></p>
              <% if (item.description) { %>
                <p class="ac-timeline-detail"><%= item.description %></p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (cv.education && cv.education.length) { %>
      <h3 class="ac-resume-subtitle">教育</h3>
      <div class="ac-timeline">
        <% cv.education.forEach(function(item){ %>
          <div class="ac-timeline-item">
            <time><%= item.period %></time>
            <div>
              <strong><%= item.title %></strong>
              <p><%= item.school %><% if (item.location) { %> · <%= item.location %><% } %></p>
              <% if (item.description) { %>
                <p class="ac-timeline-detail"><%= item.description %></p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (cv.certifications && cv.certifications.length) { %>
      <h3 class="ac-resume-subtitle">证书</h3>
      <ul class="ac-cv-list">
        <% cv.certifications.forEach(function(cert){ %>
          <li>
            <% if (cert.url) { %>
              <a href="<%= cert.url %>" target="_blank" rel="noopener noreferrer"><%= cert.name %></a>
            <% } else { %>
              <%= cert.name %>
            <% } %>
            <% if (cert.date) { %>
              <span class="ac-cv-meta"><%= cert.date %></span>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
<% } %>

<% if (cv.skills && cv.skills.length) { %>
  <section class="ac-cv-section">
    <h2 class="ac-cv-section-title">技术栈</h2>
    <div class="ac-tag-index">
      <% cv.skills.forEach(function(skill){ %>
        <span class="ac-tag-cloud"><%= skill %></span>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (personal.skills && personal.skills.length) { %>
  <section class="ac-cv-section">
    <h2 class="ac-cv-section-title">擅长方向</h2>
    <div class="ac-tag-index">
      <% personal.skills.forEach(function(skill){ %>
        <span class="ac-tag-cloud"><%= skill %></span>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (personal.interests && personal.interests.length) { %>
  <section class="ac-cv-section">
    <h2 class="ac-cv-section-title">兴趣</h2>
    <div class="ac-tag-index">
      <% personal.interests.forEach(function(item){ %>
        <span class="ac-tag-cloud"><%= item %></span>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (personal.links && personal.links.length) { %>
  <section class="ac-cv-section">
    <h2 class="ac-cv-section-title">链接</h2>
    <div class="ac-info-grid">
      <% personal.links.forEach(function(link){ %>
        <%
          var linkUrl = link.url || '#';
          var isExternal = /^(https?:)?\/\//i.test(linkUrl) || /^mailto:/i.test(linkUrl);
        %>
        <a class="ac-info-card" href="<%- isExternal ? linkUrl : url_for(linkUrl) %>" <%- isExternal ? 'target="_blank" rel="noopener noreferrer"' : '' %>>
          <span><%= link.label %></span>
          <strong><%= link.name %></strong>
          <p><%= link.description || '' %></p>
        </a>
      <% }) %>
    </div>
  </section>
<% } %>
