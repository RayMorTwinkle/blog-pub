<%
  var contentSource = (post.description || post.excerpt || post.content || '')
    .replace(/<pre[\s\S]*?<\/pre>/gi, ' ')
    .replace(/<figure[\s\S]*?<\/figure>/gi, ' ')
    .replace(/<table[\s\S]*?<\/table>/gi, ' ')
    .replace(/<aside[\s\S]*?<\/aside>/gi, ' ')
    .replace(/<h[1-6][\s\S]*?<\/h[1-6]>/gi, ' ');
  var rawContent = strip_html(contentSource)
    .replace(/!\[[^\]]*\]\([^)]+\)/g, ' ')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '$1 ')
    .replace(/`{1,3}[^`]*`{1,3}/g, ' ')
    .replace(/(^|\s)[>#*_~-]+/g, ' ')
    .replace(/[^\S\r\n]+/g, ' ')
    .replace(/https?:\/\/\S+/g, ' ')
    .replace(/&[a-z0-9#]+;/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  var commandLikeCount = (rawContent.match(/\b(sudo|npm|pnpm|yarn|brew|git|pmset|hexo)\b/gi) || []).length;
  var cjkCount = (rawContent.match(/[\u4e00-\u9fff]/g) || []).length;
  var summary = rawContent.length >= 18 && !(commandLikeCount >= 2 && cjkCount < 14)
    ? truncate(rawContent, { length: 96 })
    : '';
  var imageSource = post.cover || post.heroImage || post.image || post.thumbnail || post.banner || '';
  if (!imageSource) {
    var firstImageMatch = String(post.content || post.excerpt || '').match(/<img[^>]+src=["']([^"']+)["']/i);
    imageSource = firstImageMatch ? firstImageMatch[1] : '';
  }
  function cardAssetUrl(assetPath) {
    if (!assetPath) return '';
    if (/^(https?:)?\/\//i.test(assetPath) || /^data:/i.test(assetPath)) return assetPath;
    return url_for(assetPath);
  }
  var badge = post.badge || post.type || '';
%>
<article class="ac-post-card <%= imageSource ? 'has-media' : '' %>">
  <% if (imageSource) { %>
    <a class="ac-post-card-media" href="<%- url_for(post.path) %>" aria-label="<%= post.title %>">
      <img src="<%- cardAssetUrl(imageSource) %>" alt="<%= post.title %>" loading="lazy">
    </a>
  <% } %>
  <div class="ac-post-card-body">
    <div class="ac-post-card-head">
      <time datetime="<%= full_date(post.date, 'YYYY-MM-DD HH:mm:ss') %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
      <% if (badge) { %>
        <span class="ac-post-card-badge"><%= badge %></span>
      <% } %>
      <% if (post.tags && post.tags.length) { %>
        <div class="ac-post-card-tags">
          <% post.tags.each(function(tag){ %>
            <a href="<%- url_for(tag.path) %>"><%= tag.name %></a>
          <% }) %>
        </div>
      <% } %>
    </div>
    <h3><a href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
    <p><%= summary || '打开这篇文章，继续查看完整内容、步骤和配图。' %></p>
    <a class="ac-card-link" href="<%- url_for(post.path) %>">继续阅读</a>
  </div>
</article>
