<%
  var webProjects = site.data && site.data['static-webs'] ? site.data['static-webs'] : [];
%>

<section class="ac-webs-hero">
  <div>
    <p class="ac-eyebrow">Static Web Projects</p>
    <h1>静态网页项目合集</h1>
    <p>这里收集课堂演示、可视化教程和临时 HTML 小项目。源文件来自 Obsidian 的 <code>pub/webs</code>，同步后会原样部署到 GitHub Pages。</p>
  </div>
  <span class="ac-blog-count">共 <%= webProjects.length %> 个</span>
</section>

<% if (page.content && page.content.trim()) { %>
  <div class="ac-prose ac-webs-note">
    <%- page.content %>
  </div>
<% } %>

<% if (webProjects.length) { %>
  <section class="ac-webs-grid">
    <% webProjects.forEach(function(item){ %>
      <article class="ac-web-card">
        <div class="ac-web-card-top">
          <span class="ac-web-card-badge"><%= item.updated || '静态网页' %></span>
          <% if (item.tags && item.tags.length) { %>
            <div class="ac-project-tags">
              <% item.tags.forEach(function(tag){ %>
                <span class="ac-tag-chip"><%= tag %></span>
              <% }) %>
            </div>
          <% } %>
        </div>
        <h2><a href="<%- url_for(item.path) %>" target="_blank" rel="noopener noreferrer"><%= item.title || item.slug %></a></h2>
        <% if (item.description) { %>
          <p><%= item.description %></p>
        <% } %>
        <div class="ac-web-card-footer">
          <% if (item.source) { %>
            <span class="ac-web-card-meta"><%= item.source %></span>
          <% } %>
          <a class="ac-card-link" href="<%- url_for(item.path) %>" target="_blank" rel="noopener noreferrer">打开网页</a>
        </div>
      </article>
    <% }) %>
  </section>
<% } else { %>
  <div class="ac-empty-state">
    还没有发现静态网页项目。把 HTML 放到 <code>pub/webs</code> 后运行同步即可。
  </div>
<% } %>
