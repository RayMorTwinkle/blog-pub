<section class="ac-blog-board">
  <div>
    <p class="ac-eyebrow">Blog archive</p>
    <h1>文章相册</h1>
    <p>把从 Obsidian 同步来的笔记铺成一面文章墙。这里会自动提取正文第一张图，适合教程、截图和开发记录。</p>
  </div>
  <span class="ac-blog-count">共 <%= site.posts.length %> 篇</span>
</section>

<section class="ac-card-grid ac-blog-grid">
  <% if (site.posts.length) { %>
    <% site.posts.sort('date', -1).each(function(post){ %>
      <%- partial('partial/post-card', { post: post, theme: theme, url_for: url_for, date: date, strip_html: strip_html, show_media: true }) %>
    <% }) %>
  <% } else { %>
    <div class="ac-empty-state">这里暂时还是空的。</div>
  <% } %>
</section>
